{
  "name": "surgeons-night",
  "version": "0.1.0",
  "description": "Surgeon's Night: El Turno de Guardia — simulador 3D (Three.js) de una guardia de cirugía general de 24 horas",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:web": "node scripts/build-web.mjs",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "game",
    "cli",
    "surgery",
    "simulator"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
